{
  "name": "exa-api-poc",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "exa-api-poc": "dist/main.js"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "mcp:keyless": "npm run build && node dist/mcp_keyless.js",
    "mcp:api-key": "npm run build && node --env-file-if-exists=.env dist/mcp_api_key.js",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "clean": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exa-js": "^2.26.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
